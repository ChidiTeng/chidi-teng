# Public (inlined into the client bundle at build time)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: external booking link (Cal.com, Calendly). Falls back to /contact.
NEXT_PUBLIC_CAL_URL=
# Optional: shown on /contact and in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server only (contact form delivery via Resend). Without these, the form
# returns 503 in production and logs a warning in development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Website <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
